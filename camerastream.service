[Unit]
Description=Pi Zero 2W Camera H.264 Stream and Control Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rcsharath/camerastream
ExecStart=/usr/bin/python3 -u /home/rcsharath/camerastream/stream_server.py
ExecStopPost=/usr/bin/pkill -f rpicam-vid
Restart=always
RestartSec=10s
RateLimitIntervalSec=0
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
